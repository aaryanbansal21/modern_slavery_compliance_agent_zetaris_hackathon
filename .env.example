# Copy to .env and fill in. Never commit .env.

# ---------------------------------------------------------------- modes
# local    = offline DuckDB stand-in with the same tables (development, tests)
# zetaris  = every query goes through Zetaris (the demo and the submission)
DATA_MODE=local
# mock       = deterministic agent policies, no model calls (tests, offline)
# nightshift = models through Meterless Nightshift (the demo and the submission)
AI_MODE=mock
# The assessment covers the 12 months up to this date. Keep it fixed for the demo.
ASSESSMENT_DATE=2026-10-23
PORT=4180

# ---------------------------------------------------------------- Zetaris
# UI origin of your Zetaris install (port 3000 locally). Not the raw API on 8888.
ZETARIS_BASE_URL=http://localhost:3000
# Numeric organisation ID (see docs/SETUP.md, "Find your organisation ID").
ZETARIS_ORG_ID=
# Either an API key created in the Zetaris UI, or the admin username and password.
ZETARIS_API_KEY=
ZETARIS_USERNAME=
ZETARIS_PASSWORD=
ZETARIS_ENGINE_ID=
ZETARIS_QUERY_LIMIT=5000

# Where Zetaris reaches the three source systems. Defaults suit Zetaris in
# Docker Desktop plus `docker compose up` in this folder.
ERP_JDBC_URL=jdbc:postgresql://host.docker.internal:5433/rs_erp
REF_S3_ENDPOINT=http://host.docker.internal:9000
REF_S3_BUCKET=rs-reference
PORTAL_URL=http://host.docker.internal:8099/api/declarations.json

# ---------------------------------------------------------------- local data stack (docker compose)
PGHOST=localhost
PGPORT=5433
PGDATABASE=rs_erp
PGUSER=rs
PGPASSWORD=rs_local_dev
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=rsminio
MINIO_SECRET_KEY=rsminio-local-dev
MINIO_BUCKET=rs-reference

# ---------------------------------------------------------------- models (NVIDIA Nemotron)
# The demo calls Nemotron on NVIDIA's OpenAI-compatible API (key from build.nvidia.com).
# The client follows the Meterless provider contract, so a Meterless Nightshift endpoint
# (http://127.0.0.1:8088/v1, token from <stateDir>/proxy-token) also works here.
METERLESS_BASE_URL=https://integrate.api.nvidia.com/v1
# Your NVIDIA API key (nvapi-...) or Nightshift token. Never commit it.
METERLESS_RUNTIME_TOKEN=
METERLESS_TOKEN_FILE=
# Model per agent role. "policy" keeps a role on its deterministic rules. The drafter writes
# from tested templates so every sentence traces to evidence, and Nemotron reviews each draft.
MODEL_PLANNER=nvidia/nemotron-3-ultra-550b-a55b
MODEL_PARSER=nvidia/nemotron-3.5-bolt-e4b
MODEL_CLASSIFIER=nvidia/nemotron-3.5-bolt-e4b
MODEL_DRAFTER=policy
MODEL_EVALUATOR=nvidia/nemotron-3-ultra-550b-a55b
LLM_CONCURRENCY=4
# Cache model replies for repeat runs (set to off for a fully fresh run)
LLM_CACHE=on

# ---------------------------------------------------------------- agents
MAX_ITERATIONS=3
WORLD_NAMESPACE=harbourside
# tiered (default): the model plans; tier 2 checks wait for the evaluator to request them
# free: the model may choose any tool at any time. policy: no model for planning.
PLANNER_MODE=tiered
